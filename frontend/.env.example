# Web-app build-time config. VITE_* values are BAKED INTO THE BUNDLE at
# `docker compose build frontend`, so copy this file to .env BEFORE building:
#
#     cp frontend/.env.example frontend/.env
#
# .env itself is gitignored; this example is the source of truth for defaults.

SKIP_PREFLIGHT_CHECK=true

# Leave both URLs EMPTY for the normal setup: the UI then talks to the agent and
# to Valhalla on its own origin, and nginx proxies /routes/* -> agent and
# /route,/status,/isochrone,... -> Valhalla (see frontend/nginx.conf).
# That is what makes the app work behind a forwarded port (Codespaces, tunnels).
# Set a full URL only when the UI is served from a different origin (`npm run dev`).
VITE_AGENT_URL=
VITE_VALHALLA_URL=

VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org
VITE_TILE_SERVER_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
VITE_CENTER_COORDS="53.6772,23.8232"
VITE_DEFAULT_COSTING_MODEL=pedestrian
VITE_CLIENT_ID=grodno-poc
