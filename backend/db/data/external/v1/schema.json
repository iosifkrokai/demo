{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Данные об объектах Гродненской области",
  "description": "Один файл со всеми объектами. Каждый объект несёт свои интервалы работы, цены и события; сооружения инфраструктуры и события площадок, которых нет среди объектов, идут отдельными списками в корне. Неизвестное значение — отсутствующий ключ: пустая строка и прочерк читаются как значение, поэтому их не используем. Списки в `x-dictionaries` повторяют значения `enum` для чтения человеком; при расхождении нормативен `enum`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "sent_on",
    "sender",
    "places"
  ],
  "properties": {
    "version": {
      "title": "Версия формата",
      "description": "Обязательное поле. Ровно 1.",
      "type": "integer",
      "const": 1
    },
    "sent_on": {
      "title": "Дата отправки",
      "description": "Обязательное поле. ГГГГ-ММ-ДД",
      "type": "string",
      "format": "date"
    },
    "sender": {
      "title": "Организация",
      "description": "Обязательное поле. Кто подготовил данные: организация и, при желании, исполнитель.",
      "type": "string"
    },
    "places": {
      "title": "Объекты",
      "description": "Все объекты в одном списке.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/place"
      }
    },
    "infrastructure": {
      "title": "Объекты инфраструктуры",
      "description": "Отдельно стоящее городское сооружение на маршруте: лестница, пандус, переход, подземный переход, лифт. Показывается слоем на карте.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/infrastructure"
      }
    },
    "events": {
      "title": "События на площадках",
      "description": "События площадок, которых нет среди объектов. Событие самого объекта пишется внутри него, в его поле `events`, и сюда не дублируется.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/venue_event"
      }
    }
  },
  "x-dictionaries": {
    "Вид объекта": [
      "замок",
      "костёл",
      "церковь",
      "монастырь",
      "дворец",
      "усадьба",
      "парк",
      "музей",
      "памятник",
      "храм",
      "архитектура",
      "инфраструктура",
      "кладбище",
      "кафе",
      "ресторан",
      "туалет",
      "гостиница",
      "остановка транспорта"
    ],
    "Район / населённый пункт": [
      "Гродно (город)",
      "Берестовицкий район",
      "Волковысский район",
      "Вороновский район",
      "Гродненский район",
      "Дятловский район",
      "Зельвенский район",
      "Ивьевский район",
      "Кореличский район",
      "Лидский район",
      "Мостовский район",
      "Новогрудский район",
      "Островецкий район",
      "Ошмянский район",
      "Свислочский район",
      "Слонимский район",
      "Сморгонский район",
      "Щучинский район"
    ],
    "Да / Нет": [
      "да",
      "нет"
    ],
    "День недели": [
      "Пн",
      "Вт",
      "Ср",
      "Чт",
      "Пт",
      "Сб",
      "Вс",
      "Все дни"
    ],
    "Сезон": [
      "круглый год",
      "лето",
      "зима",
      "межсезонье"
    ],
    "Статус охраны": [
      "памятник истории и культуры",
      "историко-культурная ценность",
      "выявленный объект",
      "нет статуса"
    ],
    "Категория охраны": [
      "республиканского значения",
      "местного значения"
    ],
    "Категория посетителя": [
      "взрослый",
      "детский",
      "студент",
      "пенсионер",
      "иностранный",
      "групповой",
      "иное"
    ],
    "Тип объекта инфраструктуры": [
      "лестница",
      "пандус",
      "пешеходный переход",
      "спуск-подъём",
      "подземный переход",
      "лифт"
    ],
    "Уклон": [
      "до 5%",
      "5–8%",
      "более 8%"
    ],
    "Валюта": [
      "BYN"
    ]
  },
  "$defs": {
    "infrastructure": {
      "title": "Объект инфраструктуры",
      "description": "Отдельно стоящее городское сооружение на маршруте: лестница, пандус, переход, подземный переход, лифт. Показывается слоем на карте.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_id",
        "kind",
        "lat",
        "lon"
      ],
      "properties": {
        "external_id": {
          "title": "Идентификатор в вашей системе",
          "description": "Обязательное поле. Устойчивый номер сооружения.",
          "type": "string"
        },
        "kind": {
          "title": "Тип объекта",
          "description": "Обязательное поле. Значение из списка «Тип объекта инфраструктуры».",
          "type": "string",
          "enum": [
            "лестница",
            "пандус",
            "пешеходный переход",
            "спуск-подъём",
            "подземный переход",
            "лифт"
          ]
        },
        "lat": {
          "title": "Широта",
          "description": "Обязательное поле. WGS-84. Окно Гродненской области — 52.5–55.2: перепутанная долгота сюда не проходит.",
          "type": "number",
          "minimum": 52.5,
          "maximum": 55.2
        },
        "lon": {
          "title": "Долгота",
          "description": "Обязательное поле. WGS-84. Окно Гродненской области — 23.2–27.0: перепутанная широта сюда не проходит.",
          "type": "number",
          "minimum": 23.2,
          "maximum": 27.0
        },
        "steps": {
          "title": "Число ступеней",
          "description": "Сколько ступеней у сооружения.",
          "type": "integer",
          "minimum": 0
        },
        "ramp": {
          "title": "Есть пандус или съезд",
          "description": "«да» — true, «нет» — false; ключа нет, когда сведения не подтверждены.",
          "type": "boolean"
        },
        "gradient": {
          "title": "Уклон",
          "description": "Значение из списка «Уклон».",
          "type": "string",
          "enum": [
            "до 5%",
            "5–8%",
            "более 8%"
          ]
        },
        "surface": {
          "title": "Покрытие",
          "description": "Например: асфальт, плитка, грунт.",
          "type": "string"
        },
        "width_m": {
          "title": "Ширина, м",
          "description": "Метры.",
          "type": "number",
          "minimum": 0
        },
        "lit": {
          "title": "Освещение",
          "description": "«да» — true, «нет» — false; ключа нет, когда сведения не подтверждены.",
          "type": "boolean"
        },
        "signalised": {
          "title": "Регулируемый переход",
          "description": "Только для переходов. «да» — true, «нет» — false; ключа нет, когда сведения не подтверждены.",
          "type": "boolean"
        }
      }
    },
    "opening_hours": {
      "title": "Интервал работы",
      "description": "Один интервал: день недели или сезон, время открытия и закрытия. Объект с одинаковым графиком всю неделю описывается одной записью «Все дни».",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "minProperties": 1,
      "allOf": [
        { "dependentRequired": { "opens": ["closes"], "closes": ["opens"] } },
        { "not": { "required": ["closed", "opens"] } },
        { "not": { "required": ["closed", "round_the_clock"] } },
        { "not": { "required": ["round_the_clock", "opens"] } }
      ],
      "properties": {
        "weekday": {
          "title": "День недели",
          "description": "Значение из списка «День недели».",
          "type": "string",
          "enum": [
            "Пн",
            "Вт",
            "Ср",
            "Чт",
            "Пт",
            "Сб",
            "Вс",
            "Все дни"
          ]
        },
        "season": {
          "title": "Сезон",
          "description": "Значение из списка «Сезон».",
          "type": "string",
          "enum": [
            "круглый год",
            "лето",
            "зима",
            "межсезонье"
          ]
        },
        "valid_from": {
          "title": "Действует с",
          "description": "ГГГГ-ММ-ДД",
          "type": "string",
          "format": "date"
        },
        "valid_to": {
          "title": "Действует по",
          "description": "ГГГГ-ММ-ДД",
          "type": "string",
          "format": "date"
        },
        "opens": {
          "title": "Открытие",
          "description": "ЧЧ:ММ",
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "closes": {
          "title": "Закрытие",
          "description": "ЧЧ:ММ тех же суток. Закрытие после полуночи в поле не выразить — пишите его в note.",
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "round_the_clock": {
          "title": "Круглосуточно",
          "description": "«да» — true, «нет» — false; ключа нет, когда сведения не подтверждены.",
          "type": "boolean"
        },
        "closed": {
          "title": "Выходной",
          "description": "«да» — объект в этот день закрыт. «да» — true, «нет» — false; ключа нет, когда сведения не подтверждены.",
          "type": "boolean"
        },
        "note": {
          "title": "Примечание",
          "description": "Например: по предварительной записи.",
          "type": "string"
        },
        "as_documented": {
          "title": "Как в официальном документе",
          "description": "Дословная формулировка режима работы.",
          "type": "string"
        }
      }
    },
    "prices": {
      "title": "Цена",
      "description": "Одна цена: либо сумма с валютой, либо отметка «бесплатно», либо пояснение в note. Отметка «бесплатно» важнее суммы — именно она делает осмысленным вопрос «недорого».",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "allOf": [
        {
          "anyOf": [
            { "required": ["amount"] },
            { "required": ["free"] },
            { "required": ["note"], "properties": { "note": { "minLength": 1 } } }
          ]
        },
        { "not": { "required": ["amount", "free"] } },
        { "dependentRequired": { "amount": ["currency"] } },
        { "if": { "required": ["currency"] }, "then": { "required": ["amount"] } }
      ],
      "properties": {
        "visitor_category": {
          "title": "Категория посетителя",
          "description": "Значение из списка «Категория посетителя».",
          "type": "string",
          "enum": [
            "взрослый",
            "детский",
            "студент",
            "пенсионер",
            "иностранный",
            "групповой",
            "иное"
          ]
        },
        "amount": {
          "title": "Стоимость",
          "description": "Числом, без слова «рублей».",
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "title": "Валюта",
          "description": "Значение из списка «Валюта». Заполняется только вместе с amount.",
          "type": "string",
          "enum": [
            "BYN"
          ]
        },
        "free": {
          "title": "Бесплатно",
          "description": "Для бесплатного объекта достаточно этой пометки. «да» — true, «нет» — false; ключа нет, когда сведения не подтверждены.",
          "type": "boolean"
        },
        "note": {
          "title": "Примечание",
          "description": "Например: экскурсионное обслуживание — по договору. Заполняется, когда суммы нет.",
          "type": "string"
        },
        "valid_from": {
          "title": "Действует с",
          "description": "ГГГГ-ММ-ДД",
          "type": "string",
          "format": "date"
        },
        "valid_to": {
          "title": "Действует по",
          "description": "ГГГГ-ММ-ДД",
          "type": "string",
          "format": "date"
        }
      }
    },
    "events": {
      "title": "Событие",
      "description": "Событие на объекте: выставка, фестиваль, экскурсия. У события площадки, которой нет среди объектов, есть отдельный список в корне документа.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "external_id": {
          "title": "Идентификатор события в вашей системе",
          "description": "Устойчивый номер события. Без него повторная присылка не отличит обновлённое событие от нового.",
          "type": "string"
        },
        "title": {
          "title": "Название",
          "description": "Обязательное поле.",
          "type": "string"
        },
        "starts_on": {
          "title": "Дата начала",
          "description": "ГГГГ-ММ-ДД",
          "type": "string",
          "format": "date"
        },
        "ends_on": {
          "title": "Дата окончания",
          "description": "ГГГГ-ММ-ДД, не раньше даты начала.",
          "type": "string",
          "format": "date"
        },
        "url": {
          "title": "Ссылка",
          "description": "Полный адрес с https://",
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "note": {
          "title": "Примечание",
          "description": "Пояснение к событию, если нужно.",
          "type": "string"
        }
      }
    },
    "place": {
      "title": "Объект",
      "description": "Объект показа: памятник, музей, храм, парк, учреждение культуры. Одна карточка — один объект, с режимом работы, ценами и событиями внутри.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_id",
        "official_name",
        "address",
        "district",
        "lat",
        "lon",
        "category"
      ],
      "properties": {
        "external_id": {
          "title": "Идентификатор в вашей системе",
          "description": "Обязательное поле. Ваш учётный или инвентарный номер, уникальный внутри файла.",
          "type": "string"
        },
        "cadastral_number": {
          "title": "Кадастровый номер",
          "description": "Как выдан.",
          "type": "string"
        },
        "official_name": {
          "title": "Официальное наименование",
          "description": "Обязательное поле. Полное официальное название.",
          "type": "string"
        },
        "official_name_en": {
          "title": "Наименование на английском",
          "description": "Если существует официальное написание латиницей.",
          "type": "string"
        },
        "address": {
          "title": "Адрес",
          "description": "Обязательное поле. Официальный адрес.",
          "type": "string"
        },
        "district": {
          "title": "Район / населённый пункт",
          "description": "Обязательное поле. Значение из списка «Район / населённый пункт».",
          "type": "string",
          "enum": [
            "Гродно (город)",
            "Берестовицкий район",
            "Волковысский район",
            "Вороновский район",
            "Гродненский район",
            "Дятловский район",
            "Зельвенский район",
            "Ивьевский район",
            "Кореличский район",
            "Лидский район",
            "Мостовский район",
            "Новогрудский район",
            "Островецкий район",
            "Ошмянский район",
            "Свислочский район",
            "Слонимский район",
            "Сморгонский район",
            "Щучинский район"
          ]
        },
        "lat": {
          "title": "Широта",
          "description": "Обязательное поле. WGS-84, десятичные градусы, разделитель — точка. Окно Гродненской области — 52.5–55.2: перепутанная долгота сюда не проходит.",
          "type": "number",
          "minimum": 52.5,
          "maximum": 55.2
        },
        "lon": {
          "title": "Долгота",
          "description": "Обязательное поле. WGS-84, десятичные градусы, разделитель — точка. Окно Гродненской области — 23.2–27.0: перепутанная широта сюда не проходит.",
          "type": "number",
          "minimum": 23.2,
          "maximum": 27.0
        },
        "category": {
          "title": "Вид объекта",
          "description": "Обязательное поле. Значение из списка «Вид объекта». Сооружения — лестница, пандус, переход, лифт — пишутся в список «Объекты инфраструктуры», а не сюда.",
          "type": "string",
          "enum": [
            "замок",
            "костёл",
            "церковь",
            "монастырь",
            "дворец",
            "усадьба",
            "парк",
            "музей",
            "памятник",
            "храм",
            "архитектура",
            "инфраструктура",
            "кладбище",
            "кафе",
            "ресторан",
            "туалет",
            "гостиница",
            "остановка транспорта"
          ]
        },
        "official_classification": {
          "title": "Официальная классификация",
          "description": "Ваша формулировка из учётных документов. Пользователю не показывается.",
          "type": "string"
        },
        "description": {
          "title": "Краткое описание",
          "description": "До 400 знаков, факты без рекламы.",
          "type": "string",
          "maxLength": 400
        },
        "official_page": {
          "title": "Страница на официальном сайте",
          "description": "Полный адрес с https://",
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "phone": {
          "title": "Телефон",
          "description": "Только организации, не частного лица.",
          "type": "string"
        },
        "website": {
          "title": "Сайт",
          "description": "Полный адрес с https://",
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "built_year": {
          "title": "Год постройки",
          "description": "4 знака; при нескольких этапах — первый.",
          "type": "integer",
          "minimum": 1000,
          "maximum": 2100
        },
        "architect": {
          "title": "Архитектор",
          "description": "ФИО либо «неизвестен».",
          "type": "string"
        },
        "accessibility": {
          "title": "Доступность",
          "description": "Доступность объекта и пригодность для посещения с детьми. Каждое значение — только по подтверждённым сведениям.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "allOf": [
            {
              "if": { "required": ["step_free_entrance"], "properties": { "step_free_entrance": { "const": true } } },
              "then": { "properties": { "entrance_steps": { "const": 0 } } }
            },
            {
              "if": { "required": ["ramp"], "properties": { "ramp": { "const": false } } },
              "then": { "not": { "required": ["ramp_gradient"] } }
            }
          ],
          "properties": {
            "step_free_entrance": {
              "title": "Вход без ступеней",
              "description": "Вход без ступеней и порогов. «да» — true, «нет» — false; ключа нет, когда сведения не подтверждены.",
              "type": "boolean"
            },
            "entrance_steps": {
              "title": "Число ступеней у входа",
              "description": "0, если ступеней нет.",
              "type": "integer",
              "minimum": 0
            },
            "ramp": {
              "title": "Пандус",
              "description": "Пандус или съезд у входа. «да» — true, «нет» — false; ключа нет, когда сведения не подтверждены.",
              "type": "boolean"
            },
