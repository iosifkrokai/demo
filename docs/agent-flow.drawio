<mxfile host="app.diagrams.net">
  <diagram id="agent-flow" name="Флоу агента — человеческим языком">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" page="1" pageWidth="1300" pageHeight="2000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="a" value="Турист пишет с телефона:&#10;«прогулка по Гродно, замок и кофе»" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="440" y="40" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b" value="Сервер принимает запрос&#10;(параллельно клиенту летят статусы:&#10;«понимаю… ищу… рисую…»)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="420" y="140" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c" value="Это правка готового&#10;маршрута? («добавь кафе»)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="510" y="240" width="120" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d" value="Правка — тут всё просто и безопасно:&#10;1) понимаем, что просят (без нейросети, по словам)&#10;2) убираем/добавляем/переставляем остановки,&#10;старый маршрут не выбрасываем никогда&#10;3) заново рисуем линию и честно отчитываемся,&#10;что выполнили, а что нет" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="330" height="140" as="geometry" />
        </mxCell>
        <mxCell id="e" value="Новый запрос — полная прокладка&#10;&#10;Шаг 1. Понять запрос.&#10;Нейросеть с «руками»: она сама лезет в базу —&#10;проверяет районы, ищет места, смотрит факты.&#10;Нейросеть недоступна/ошиблась — страхующая&#10;логика понимает запрос по ключевым словам" style="rounded=1;whiteSpace=wrap;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="380" width="340" height="130" as="geometry" />
        </mxCell>
        <mxCell id="f" value="Шаг 2. Превратить в план:&#10;город/область, сколько времени гуляем,&#10;что обязательно, что запрещено" style="rounded=1;whiteSpace=wrap;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="540" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="g" value="Просит про Вильнюс или Минск?&#10;Мы работаем только по Гродненской области —&#10;честно отказываем, а не везём в Лиду" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="500" y="640" width="140" height="110" as="geometry" />
        </mxCell>
        <mxCell id="h" value="Шаг 3. Собрать кандидатов.&#10;Смысло­вый поиск (эмбеддинги) + ключевые слова,&#10;с прицелом на GPS туриста или названный город.&#10;Чистим: один замок не должен попасть в список дважды&#10;под двумя именами; убранное руками не возвращается" style="rounded=1;whiteSpace=wrap;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="780" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="i" value="Просят «покажи что есть»,&#10;а не маршрут?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="510" y="920" width="120" height="90" as="geometry" />
        </mxCell>
        <mxCell id="j" value="Даём список по городам —&#10;выбор за туристом, линию не рисуем" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="800" y="930" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="k" value="Шаг 4. Оставить то, во что можно дойти.&#10;Держим кандидатов рядом друг с другом,&#10;если это прогулка по городу (а не «всё по области»).&#10;Сервисы (кафе, туалеты) — не остановки,&#10;они будут «по пути» на готовой линии" style="rounded=1;whiteSpace=wrap;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="1040" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="l" value="Шаг 5. Померить ноги.&#10;Спрашиваем у маршрутизатора (Valhalla),&#10;сколько минут между каждой парой мест.&#10;Если время поджимает — берём меньше мест,&#10;но честно говорим об этом в ответе" style="rounded=1;whiteSpace=wrap;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="1180" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="m" value="Шаг 6. Собрать маршрут.&#10;Ищем порядок, при котором гулять меньше всего.&#10;Если не сходится — пробуем без кафе, потом&#10;снова с ними; всё равно не сходится — только тогда ошибка&#10;Затем Valhalla ещё раз причесывает порядок&#10;и выкидывает места, до которых не дойти" style="rounded=1;whiteSpace=wrap;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="1310" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n" value="Шаг 7–8. Нарисовать и объяснить.&#10;Рисуем линию от GPS-точки через все остановки.&#10;Пишем человеческое объяснение:&#10;почему такой порядок, сколько идти" style="rounded=1;whiteSpace=wrap;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="1460" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="o" value="Шаг 9. Проверка без нейросети.&#10;Отдельная строгая логика сверяет каждый пункт просьбы&#10;с готовым маршрутом: замок на месте? кофе по пути?&#10;Невыполненное — честно помечается, а не замалчивается" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;whiteSpace=wrap;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="1580" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p" value="Ответ туристу: карта, остановки, время,&#10;объяснение и статус по каждому пожеланию" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="420" y="1710" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="q" value="Внешние сервисы:&#10;• Valhalla — расстояния, порядок, линия маршрута&#10;• база POI + эмбеддинги&#10;• OpenRouter (нейросеть) — только на шаге «понять»;&#10;если денег на счету нет, стенд работает и без неё" style="rounded=0;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="840" y="1180" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="да" style="edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;fontSize=10;" edge="1" parent="1" source="c" target="d"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="нет" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;" edge="1" parent="1" source="c" target="e"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="e" target="f"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="f" target="g"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="нет" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;fontSize=10;" edge="1" parent="1" source="g" target="h"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="h" target="i"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="да" style="edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;fontSize=10;" edge="1" parent="1" source="i" target="j"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="нет" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;fontSize=10;" edge="1" parent="1" source="i" target="k"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="k" target="l"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="l" target="m"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="m" target="n"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="n" target="o"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="o" target="p"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" style="dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="q" target="m"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e17" style="dashed=1;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="q" target="h"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed1" style="dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.3;" edge="1" parent="1" source="d" target="p"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
