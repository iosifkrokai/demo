# postgres (db service)
POSTGRES_USER=grodno
POSTGRES_PASSWORD=grodno
POSTGRES_DB=grodno

# backend — host venv; the containers get their own addresses from compose
DATABASE_URL=postgresql://grodno:grodno@localhost:5432/grodno
VALHALLA_URL=http://localhost:8002

# backend — required to plan a route; without a key /routes/* answer 503.
# One of two providers is chosen in agent/llm.py: `openrouter` (default) or
# `anthropic`. AGENT_MODEL_PROVIDER wins; otherwise whichever key is set decides.
AGENT_MODEL_PROVIDER=
OPENROUTER_API_KEY=
AGENT_INTERPRET_MODEL=
# Anthropic format — also covers a self-hosted gateway speaking it.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# observability — optional; tracing is a no-op unless the token is set
LOGFIRE_TOKEN=

# frontend — build-time; Vite inlines these into the bundle
VITE_AGENT_URL=
VITE_VALHALLA_URL=
VITE_NOMINATIM_URL=
VITE_TILE_SERVER_URL=
VITE_CENTER_COORDS=53.6778,23.8295
VITE_DEFAULT_COSTING_MODEL=pedestrian
VITE_CLIENT_ID=grodno-guide
