# ── Postgres (db service) ──
POSTGRES_USER=grodno
POSTGRES_PASSWORD=grodno
POSTGRES_DB=grodno

# ── Agent (backend/agent) ──
# DSN the agent uses to reach Postgres. In docker compose the agent connects
# to the `db` service; for local dev (venv) use localhost.
# DATABASE_URL=postgresql://grodno:grodno@localhost:5432/grodno
# VALHALLA_URL=http://localhost:8002

# LLM via OpenRouter — optional. Without a key the agent runs in degraded
# keyword-only mode (no embeddings, no rerank, no LLM intent parsing).
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# ── Frontend (Vite) — same file, no separate frontend/.env ──
SKIP_PREFLIGHT_CHECK=
# Frontend build-time values. Empty AGENT/VALHALLA/NOMINATIM/TILE URLs are correct:
# the app calls the same origin and nginx proxies /routes/* and /route|/status|…
# But CENTER_COORDS and DEFAULT_COSTING are NOT same-origin: when they are empty
# the bundle falls back to map/constants.ts's 52.51831 (Berlin) and routes.tsx's
# `bicycle`, and a Grodno plan then draws hundreds of kilometres off-screen — the
# map opens on Berlin while the route sits in Grodno.
VITE_AGENT_URL=
VITE_VALHALLA_URL=
VITE_NOMINATIM_URL=
VITE_TILE_SERVER_URL=
VITE_CENTER_COORDS=53.6778,23.8295
VITE_DEFAULT_COSTING_MODEL=pedestrian
VITE_CLIENT_ID=grodno-guide

# ── Backend (host-run agent) ──
DATABASE_URL=postgresql://grodno:grodno@localhost:5432/grodno
VALHALLA_URL=http://localhost:8002
