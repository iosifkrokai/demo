# postgres (db service)
POSTGRES_USER=grodno
POSTGRES_PASSWORD=grodno
POSTGRES_DB=grodno

# backend — host venv; the containers get their own addresses from compose
DATABASE_URL=postgresql://grodno:grodno@localhost:5432/grodno
VALHALLA_URL=http://localhost:8002

# --- the model -----------------------------------------------------------------
# One provider at a time. LLM_PROVIDER wins; otherwise whichever key below is set
# decides. LLM_MODEL overrides the provider's own default (see core/config.py,
# where a model name is written once).
LLM_PROVIDER=
LLM_MODEL=

# OpenRouter, or any OpenAI-shaped endpoint.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=

# The Anthropic Messages format — also covers a self-hosted gateway speaking it.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL="https://llm.azati.ai"

# observability — optional; tracing is a no-op unless the token is set
LOGFIRE_TOKEN=

# frontend — build-time; Vite inlines these into the bundle
VITE_AGENT_URL=
VITE_VALHALLA_URL=
VITE_NOMINATIM_URL=
VITE_TILE_SERVER_URL=
VITE_CENTER_COORDS=53.6778,23.8295
VITE_DEFAULT_COSTING_MODEL=pedestrian
VITE_CLIENT_ID=grodno-guide
