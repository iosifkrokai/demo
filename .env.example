# postgres (db service)
POSTGRES_USER=grodno
POSTGRES_PASSWORD=grodno
POSTGRES_DB=grodno

# backend — host venv; the containers get their own addresses from compose
DATABASE_URL=postgresql://grodno:grodno@localhost:5432/grodno
VALHALLA_URL=http://localhost:8002

# --- the model -----------------------------------------------------------------
# One OpenAI-shaped endpoint. LLM_MODEL overrides the default named in
# core/config.py.
#
# The model MUST accept a forced tool call: the plan is handed in by calling a
# terminal tool, so PydanticAI sends tool_choice="required". The thinking-mode
# models on a gateway reject it with a 400 and answer every planning request with
# 503; their `-no-thinking` siblings are the ones to name here.
LLM_MODEL=

# OpenRouter, or any OpenAI-shaped endpoint such as a self-hosted gateway.
OPENROUTER_API_KEY=
# e.g. https://llm.azati.ai/v1 — a gateway is reached by pointing this at it
OPENROUTER_BASE_URL=

# observability — optional; tracing is a no-op unless the token is set
LOGFIRE_TOKEN=

# set to 1 to turn the in-process reading cache off for this process
CACHE_BUST=

# frontend — build-time; Vite inlines these into the bundle
VITE_AGENT_URL=
VITE_VALHALLA_URL=
VITE_NOMINATIM_URL=
VITE_CENTER_COORDS=53.6778,23.8295
VITE_DEFAULT_COSTING_MODEL=pedestrian
